# ==============================================================================
# Y2MATEVIDEO PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC ENVIRONMENT VARIABLES (Exposed to Client Bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://y2matevideo.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. SERVER ONLY VARIABLES (Next.js App Router Server Components & API Routes)
# ------------------------------------------------------------------------------
USER_SESSION_SECRET="change-this-to-a-secure-64-character-random-string-in-production"
ADMIN_SESSION_SECRET="change-this-to-a-secure-64-character-admin-secret-in-production"
ADMIN_PASSWORD_HASH="$2a$12$e86/7Yd8f28X95j7H6.a9.z4g3B8n1C7v5m0k2L4p9Q1w3E5r7t9y" # Default: admin123

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Supabase PostgreSQL / Direct Postgres)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-do-not-expose"

# ------------------------------------------------------------------------------
# 4. STORAGE PROVIDER (Cloudflare R2 / AWS S3 / Compatible Object Vault)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="r2" # Options: memory, local, r2, s3
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_BUCKET="y2matevideo-temp-media"
STORAGE_ACCESS_KEY="your-access-key-id"
STORAGE_SECRET_KEY="your-secret-access-key-do-not-expose"
STORAGE_REGION="auto"
STORAGE_PUBLIC_DOMAIN="https://cdn.y2matevideo.com"

# ------------------------------------------------------------------------------
# 5. BILLING & SUBSCRIPTIONS (Lemon Squeezy / Stripe Provider)
# ------------------------------------------------------------------------------
BILLING_PROVIDER="lemon_squeezy" # Options: mock, lemon_squeezy, stripe
BILLING_API_KEY="your-billing-provider-api-key-do-not-expose"
BILLING_WEBHOOK_SECRET="your-billing-webhook-hmac-secret-do-not-expose"
PREMIUM_PLAN_PROVIDER_ID="variant_123456"

# ------------------------------------------------------------------------------
# 6. MEDIA PROCESSING WORKER NODE (Worker Only)
# ------------------------------------------------------------------------------
WORKER_URL="https://worker.y2matevideo.com"
WORKER_SECRET="your-worker-internal-api-secret-key-do-not-expose"
WORKER_CONCURRENCY=2
WORKER_ID="worker_node_01"
MAX_INPUT_FILE_SIZE_MB=500
MAX_OUTPUT_FILE_SIZE_MB=500
PROCESSING_TIMEOUT_SECONDS=300
JOB_TTL_MINUTES=60
MAX_JOB_RETRIES=2
FFMPEG_PATH="ffmpeg"
TEMP_DIR="/tmp/y2matevideo"

# ------------------------------------------------------------------------------
# 7. SECURITY & RATE LIMITS
# ------------------------------------------------------------------------------
ANALYZE_RATE_LIMIT=10
DOWNLOAD_RATE_LIMIT=5
FREE_DAILY_ANALYSES=20
FREE_DAILY_DOWNLOADS=10
PREMIUM_DAILY_ANALYSES=200
PREMIUM_DAILY_DOWNLOADS=100

